# Required in production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
SESSION_SECRET="generate-a-48-byte-random-value"
NEXT_PUBLIC_SITE_URL="https://institute.kingsword.org"

# Private manual-payment instructions shown only to signed-in students whose
# enrollment is pending. Store real values in Vercel, never in this file.
PAYMENT_BANK_ACCOUNT_NAME="Your organization name"
PAYMENT_BANK_NAME="Your bank name"
PAYMENT_BANK_ACCOUNT_NUMBER="Your account number"
PAYMENT_BANK_ROUTING_NUMBER="Your routing number"

# Used only while running `npm run admin:create`
ADMIN_EMAIL="kti@kingsword.org"
ADMIN_PASSWORD="replace-with-a-unique-12-character-or-longer-password"
ADMIN_NAME="KingsWord Administrator"
ADMIN_COUNTRY="United States"
