# Required in production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
SESSION_SECRET="generate-a-48-byte-random-value"
NEXT_PUBLIC_SITE_URL="https://www.thekti.org"

# Stripe-hosted Checkout. Keep every value server-only in Vercel. Start with
# test-mode values, then replace all five together when production is approved.
APP_BASE_URL="https://www.thekti.org"
STRIPE_MODE="test"
STRIPE_SECRET_KEY="set-directly-in-vercel-never-commit"
STRIPE_WEBHOOK_SECRET="set-directly-in-vercel-never-commit"
STRIPE_PRICE_CERTIFICATE="price_test_single_certificate"
STRIPE_PRICE_ADVANCED="price_test_advanced_program"

# Private manual-payment instructions shown only to signed-in students whose
# enrollment is pending. Store real values in Vercel, never in this file.
PAYMENT_BANK_ACCOUNT_NAME="Your organization name"
PAYMENT_BANK_NAME="Your bank name"
PAYMENT_BANK_ACCOUNT_NUMBER="Your account number"
PAYMENT_BANK_ROUTING_NUMBER="Your routing number"

# Used only while running `npm run stripe:promo`. The promotion code lives in
# Stripe, not in the running app, so these are never needed in Vercel.
# This code takes 100% off the full program: whoever has it enrolls for free.
# Both limits are required by the script. Set a number and a date to cap the
# giveaway; `unlimited` and `never` are accepted, but only as a deliberate
# choice — an uncapped code has no automatic stop and nothing to refund.
PROMO_CODE="ORDAINEDMINISTERS2026"
PROMO_MAX_REDEMPTIONS="unlimited"
PROMO_EXPIRES_ON="never"

# Used only while running `npm run admin:create`
ADMIN_EMAIL="kti@kingsword.org"
ADMIN_PASSWORD="replace-with-a-unique-12-character-or-longer-password"
ADMIN_NAME="KingsWord Administrator"
ADMIN_COUNTRY="United States"
